# Alternative without Docker: run uvicorn from a virtualenv under systemd.
# Install (as root):
#   useradd --system --home /opt/olfdb --shell /usr/sbin/nologin olfdb
#   python3 -m venv /opt/olfdb/venv && /opt/olfdb/venv/bin/pip install -r /opt/olfdb/requirements.txt
#   chown -R olfdb:olfdb /opt/olfdb
#   cp deploy/olfdb-venv.service /etc/systemd/system/olfdb.service && systemctl daemon-reload && systemctl enable --now olfdb
[Unit]
Description=Odor response database (uvicorn)
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=simple
User=olfdb
Group=olfdb
WorkingDirectory=/opt/olfdb
Environment=OLFDB_DATA_DIR=/opt/olfdb/data
# where the lab NAS (tensor) is mounted, if not at /local/tensor (it must be readable by olfdb):
#Environment=OLFDB_TENSOR_ROOT=/local/tensor
ExecStart=/opt/olfdb/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080 --workers 1
Restart=always
RestartSec=5s
# Of the server's files, the service sees only what it needs: the most it can ever read or
# write. The Admin tab can only narrow that (DEPLOY.md, "Folders it may read and write").
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/olfdb/data
# of /mnt and /local, only tensor, read-only (if it is elsewhere, change this with
# OLFDB_TENSOR_ROOT); a folder it may write (e.g. for backups, later) also needs
# ReadWritePaths= (BindPaths= under /mnt or /local)
TemporaryFileSystem=/mnt:ro /local:ro
BindReadOnlyPaths=-/local/tensor

[Install]
WantedBy=multi-user.target
