# Alternative without Docker: run uvicorn from a virtualenv under systemd.
# Install (as root):
#   useradd --system --home /opt/olfdb --shell /usr/sbin/nologin olfdb
#   python3 -m venv /opt/olfdb/venv && /opt/olfdb/venv/bin/pip install -r /opt/olfdb/requirements.txt
#   chown -R olfdb:olfdb /opt/olfdb
#   cp deploy/olfdb-venv.service /etc/systemd/system/olfdb.service && systemctl daemon-reload && systemctl enable --now olfdb
[Unit]
Description=Odor response database (uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=olfdb
Group=olfdb
WorkingDirectory=/opt/olfdb
Environment=OLFDB_DATA_DIR=/opt/olfdb/data
# Google sheet with odor metadata (see DEPLOY.md):
#Environment=OLFDB_ODOR_SHEET_URL=https://docs.google.com/spreadsheets/d/<id>/edit
ExecStart=/opt/olfdb/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080 --workers 1
Restart=always
RestartSec=5s
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/olfdb/data

[Install]
WantedBy=multi-user.target
